{% for post in posts %}<article class="post-row" data-reveal><div class="post-date">{{ post.date | readableDate }}</div><div><a class="post-title" href="{{ post.url | url }}">{{ post.data.title }} <span>↗</span></a><p>{{ post.data.description }}</p><div class="tags">{% for topic in post.data.topics %}<a href="{{ ('/tags/' + (topic | topicSlug) + '/') | url }}">{{ topic }}</a>{% endfor %}</div></div></article>{% endfor %}
